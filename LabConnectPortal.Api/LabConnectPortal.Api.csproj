<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>LabConnectPortal.Api</RootNamespace>
    <AssemblyName>LabConnectPortal.Api</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Angular SPA lives beside the API at repo root: LabConnectPortal.Web -->
    <SpaRoot>$(MSBuildThisFileDirectory)..\LabConnectPortal.Web\</SpaRoot>
    <SpaDistBrowser>$(SpaRoot)dist\lab-connect-portal.web\browser\</SpaDistBrowser>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Domain\Lab*.cs" />
    <Compile Remove="Domain\Reception*.cs" />
    <Compile Remove="Domain\Recept*.cs" />
    <Compile Remove="Domain\SRLabName.cs" />
    <Compile Remove="Domain\Test*.cs" />
    <Compile Remove="Infra\**" />
    <Compile Remove="AddSamanehExtention.cs" />
    <Compile Remove="AddPTNServiceExtension.cs" />
    <!-- leftover locked nested folder from restructure; safe to delete when unlocked -->
    <Compile Remove="LabConnectPortal\**" />
    <Content Remove="LabConnectPortal\**" />
    <None Remove="LabConnectPortal\**" />
    <EmbeddedResource Remove="LabConnectPortal\**" />
  </ItemGroup>
  <Target Name="FreeDevPorts" BeforeTargets="Run">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\free-port.ps1&quot;" />
  </Target>
  <!-- Build Angular and include output in wwwroot only during publish (Azure / FolderProfile). -->
  <Target Name="PublishAngularSpa" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(SpaRoot)package.json')" Text="Angular SPA not found at '$(SpaRoot)'. Expected LabConnectPortal.Web beside LabConnectPortal.Api at the repository root. Also ensure Node.js LTS is installed on the build agent." />
    <!-- Skip reinstall when node_modules is already present (local publish / warmed CI cache). -->
    <PropertyGroup>
      <_SpaNeedsNpmInstall Condition="!Exists('$(SpaRoot)node_modules\@angular\core\package.json')">true</_SpaNeedsNpmInstall>
    </PropertyGroup>
    <Message Importance="high" Text="Installing npm packages for SPA at $(SpaRoot)" Condition="'$(_SpaNeedsNpmInstall)' == 'true'" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci --registry https://registry.npmjs.org/" Condition="'$(_SpaNeedsNpmInstall)' == 'true' AND Exists('$(SpaRoot)package-lock.json')" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_NpmCiExitCode" />
    </Exec>
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install --registry https://registry.npmjs.org/" Condition="'$(_SpaNeedsNpmInstall)' == 'true' AND ('$(_NpmCiExitCode)' != '0' OR !Exists('$(SpaRoot)package-lock.json'))" />
    <Error Condition="!Exists('$(SpaRoot)node_modules\@angular\core\package.json')" Text="npm install failed for '$(SpaRoot)'. Ensure Node.js LTS is on PATH and the npm registry is reachable." />
    <Message Importance="high" Text="Building Angular production bundle..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npx ng build --configuration=production" />
    <Error Condition="!Exists('$(SpaDistBrowser)index.html')" Text="Angular build succeeded but '$(SpaDistBrowser)index.html' was not found. Check angular.json outputPath." />
    <ItemGroup>
      <_OldWwwrootFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*.*" />
    </ItemGroup>
    <Delete Files="@(_OldWwwrootFiles)" TreatErrorsAsWarnings="true" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot')" />
    <ItemGroup>
      <_SpaBrowserFiles Include="$(SpaDistBrowser)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SpaBrowserFiles)" DestinationFiles="@(_SpaBrowserFiles->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\wwwroot\.gitkeep" Lines="" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <_WwwrootPublish Include="$(MSBuildProjectDirectory)\wwwroot\**\*.*" Exclude="$(MSBuildProjectDirectory)\wwwroot\.gitkeep" />
      <ResolvedFileToPublish Include="@(_WwwrootPublish->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MailKit" Version="4.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.27" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.27" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Syncfusion.EJ2.WordEditor.AspNet.Core" Version="32.1.19" />
    <PackageReference Include="itext" Version="9.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Infrastructure\ViewModels\Rasa\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LabConnectPortal.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Update="SeedAssets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.*" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="8.*" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.*" />
  </ItemGroup>
</Project>
